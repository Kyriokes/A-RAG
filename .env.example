# Copiar a .env y completar. Nunca subir .env al repo.
ENV=local
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/arag

# Embeddings (mismo modelo en todos los entornos)
EMBEDDING_PROVIDER=ollama            # ollama | openai_compat | fake
EMBEDDING_PROVIDER_MODEL=bge-m3      # en Workers AI: @cf/baai/bge-m3
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_API_KEY=

# LLM (endpoint compatible con OpenAI)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=

# Juez de evals
JUDGE_BASE_URL=
JUDGE_MODEL=
JUDGE_API_KEY=

# Evals contra producción
EVAL_KEY=
EVAL_MAX_USD=1
