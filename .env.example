# Copiar a .env y completar. Nunca subir .env al repo.
# Con ENV=prod, app/settings.py lee además .env.prod (ver docs/deploy.md). Lo que no se
# pone acá toma el valor de app/settings.py; los umbrales no se cambian sin pedido explícito.
ENV=local
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/arag

# Embeddings (mismo modelo en todos los entornos)
EMBEDDING_PROVIDER=ollama            # ollama | openai_compat | fake
EMBEDDING_PROVIDER_MODEL=bge-m3      # en Workers AI: @cf/baai/bge-m3
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_API_KEY=

# make parity: Ollama contra el proveedor de producción (Etapa 2)
PARITY_OLLAMA_BASE_URL=http://localhost:11434
PARITY_OLLAMA_MODEL=bge-m3
PARITY_PROD_BASE_URL=                # Workers AI: https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
PARITY_PROD_MODEL=@cf/baai/bge-m3
PARITY_PROD_API_KEY=

# LLM (endpoint compatible con OpenAI)
LLM_PROVIDER=openai_compat           # openai_compat | fake (respuestas simuladas, solo pruebas)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=

# Juez de evals
JUDGE_BASE_URL=
JUDGE_MODEL=
JUDGE_API_KEY=

# Evals contra producción
EVAL_KEY=
# Clave del HMAC que identifica a los clientes en los contadores diarios y los logs (en
# Render la genera el Blueprint). Vacía: una al azar por proceso.
CLIENT_KEY_SECRET=
EVAL_MAX_USD=1

# Umbral de abstención: vacío hasta calibrarlo en la Etapa 5 (evals/calibration/abstention.json)
# ABSTAIN_MIN_SIMILARITY=

# Índice que sirve la API (vacío: el activo). Cambiarlo es la vuelta atrás.
ACTIVE_INDEX_VERSION=

# API pública (Etapa 7). Un valor de 0 o menos apaga el límite.
CORS_ORIGINS='["http://localhost:3000"]'
FORWARDED_ALLOW_IPS=127.0.0.1,::1    # proxies que pueden fijar X-Forwarded-For
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_DAY=30
SEARCH_RATE_LIMIT_PER_MINUTE=20      # /search, contado aparte de /ask
SEARCH_RATE_LIMIT_PER_DAY=300
REQUEST_MAX_BYTES=16384              # cuerpos más grandes: 413
DAILY_TOKEN_BUDGET=120000
ANSWER_CACHE_TTL_DAYS=30
RATE_LIMIT_RETENTION_DAYS=7
LOG_LEVEL=INFO
LOG_QUESTION_TEXT=false              # el log guarda un hash de la pregunta, no el texto
